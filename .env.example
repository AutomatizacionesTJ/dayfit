# Supabase → Project Settings → API (o la salida de `npx supabase start` en local)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# "Publishable key" (sb_publishable_...). La antigua "anon key" también funciona.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública de la app (se usa como respaldo para enlaces de email y OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Muestra el botón "Continuar con Google" (configura antes el proveedor en Supabase)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Solo para Supabase local con Google activado (supabase/config.toml)
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Clave de la API de Claude (console.anthropic.com → API Keys). Solo servidor: NUNCA con NEXT_PUBLIC_.
# Opcional: sin ella el armario funciona, pero sin análisis con IA.
ANTHROPIC_API_KEY=
